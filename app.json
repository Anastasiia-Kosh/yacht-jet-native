{
  "expo": {
    "name": "YachtJet",
    "slug": "yacht-jet-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yachtjetnative",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anastasiakosh.yachtjet"
    },
    "android": {
      "package": "com.anastasiakosh.yachtjet",
      "adaptiveIcon": {
        "backgroundColor": "#071F3B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071F3B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c32094b2-dc07-4604-a490-9dcebf0fd87b"
      }
    }
  }
}
